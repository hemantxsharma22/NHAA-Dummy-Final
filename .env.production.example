# ==============================================================================
# SAATHI-AI & NHAA PORTAL — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
#
# ──────────────────────────────────────────────────────────────────────────────
# 1. RENDER (FastAPI Python Backend: saathi-ai-backend)
# ──────────────────────────────────────────────────────────────────────────────
#
# Real-time Voice STT (Deepgram Nova-2 streaming WebSocket)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Assistant Chatbot (Groq API — Ultra-fast inference with LLaMA 3.3)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Assistant Chatbot (Google Gemini API — starts with AIzaSy...)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Fallback LLM Key (OpenRouter / OpenAI)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Production CORS — Add your Vercel frontend URL(s) comma-separated (or * for all)
ALLOWED_ORIGINS=https://nhaa-portal.vercel.app,https://your-custom-domain.gov.in

# Database URL (SQLite by default; for Render PostgreSQL use PostgreSQL Internal URL)
DATABASE_URL=sqlite:///./saathi_dev.db

# Host and Port (Render automatically sets $PORT)
HOST=0.0.0.0
PORT=8000

# ──────────────────────────────────────────────────────────────────────────────
# 2. VERCEL (React Vite Frontend: nhaa-portal)
# ──────────────────────────────────────────────────────────────────────────────
#
# Production Backend URL (Points to your deployed Render FastAPI Web Service)
VITE_SAATHI_API_URL=https://saathi-ai-backend.onrender.com

# Optional WebSocket URL (Automatically derived as wss://... from VITE_SAATHI_API_URL if omitted)
# VITE_SAATHI_WS_URL=wss://saathi-ai-backend.onrender.com

# Firebase Web Client Configuration (Citizen Google Login & Auth)
VITE_FIREBASE_API_KEY=AIzaSyDqkrg-UfqlzNDl2-_57GvEIyAJuCcB0gs
VITE_FIREBASE_AUTH_DOMAIN=auth-992b1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=auth-992b1
VITE_FIREBASE_STORAGE_BUCKET=auth-992b1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=434503888351
VITE_FIREBASE_APP_ID=1:434503888351:web:3e64a5547296b2d7d9a86a
