# ==============================================================================
# SAATHI-AI & NHAA PORTAL — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
#
# ──────────────────────────────────────────────────────────────────────────────
# 1. RENDER (FastAPI Python Backend: saathi-ai-backend)

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Production CORS — Add your Vercel frontend URL(s) comma-separated (or * for all)
ALLOWED_ORIGINS=https://nhaa-portal.vercel.app,https://your-custom-domain.gov.in

# Database URL (SQLite by default; for Render PostgreSQL use PostgreSQL Internal URL)
DATABASE_URL=sqlite:///./saathi_dev.db

# Host and Port (Render automatically sets $PORT)
HOST=0.0.0.0
PORT=8000

# ──────────────────────────────────────────────────────────────────────────────
# 2. VERCEL (React Vite Frontend: nhaa-portal)
# ──────────────────────────────────────────────────────────────────────────────
#
# Production Backend URL (Points to your deployed Render FastAPI Web Service)
VITE_SAATHI_API_URL=https://saathi-ai-backend.onrender.com

