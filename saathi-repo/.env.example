# ==========================================
# SAATHI-AI Environment Configuration Example
# Copy this file to .env and fill in values.
# ==========================================

# ── Backend Configuration ──────────────────────────────────────────────────
ENVIRONMENT=production
# HOST: 0.0.0.0 is recommended for Docker / cloud deployments (Render, Railway, Fly.io, etc.)
HOST=0.0.0.0
PORT=8000

# Database URL: defaults to SQLite; supports PostgreSQL in production (e.g. postgresql://user:pass@host:5432/saathidb)
DATABASE_URL=sqlite:///./saathi_dev.db

# CORS Allowed Origins: comma-separated list of frontend domains or "*" for unrestricted
ALLOWED_ORIGINS=http://localhost:3000,https://saathi-ai.vercel.app

# ── Server-Side API Keys (NEVER exposed to frontend or browser) ─────────────
# 1. Deepgram API key — Real-time Speech-to-Text via Server-side WebSocket Proxy
# Get key from: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 2. Google Gemini API key — Fast AI Assistant Chatbot
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. LLM API key (OpenAI GPT-4o-mini) — Contextual analysis & case briefings
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
LLM_API_KEY=your_llm_api_key_here
# Optional: custom base URL / proxy
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Frontend Configuration (Publicly accessible in client build) ───────────
# Base HTTP URL pointing to the deployed backend FastAPI service
# Local dev: http://localhost:8000
# Production: https://your-backend-service.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Explicit WebSocket URL (if different from NEXT_PUBLIC_API_URL or behind special WAF/proxy)
# Production: wss://your-backend-service.onrender.com
# NEXT_PUBLIC_WS_URL=wss://your-backend-service.onrender.com


